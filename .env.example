# SerpApi Private Key (Get a free key from https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_key_here

# Hugging Face Read Token (Get from https://huggingface.co/settings/tokens)
# IMPORTANT: Accept the Gemma 2 license first at https://huggingface.co/google/gemma-2-2b-it
HUGGINGFACE_TOKEN=hf_your_token_here
